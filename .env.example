# Primary provider, required for the live demo.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Optional, only for demoing the provider-agnostic second path.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Local testing without spending API credits. Ollama's OpenAI-compatible
# endpoint. OLLAMA_API_KEY isn't a real secret -- the OpenAI SDK just
# requires a non-empty string.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=gemma4:31b-cloud

# Which provider the CLI defaults to when --provider isn't passed.
# AUDIT_LOG_PROVIDER=ollama
